

pip install -U ultralytics
yolo export model=yolo26n.pt format=tflite imgsz=640
cp yolo26n_saved_model/yolo26n_float32.tflite app/src/main/assets/

# voice commands (app/src/main/assets/commands.tflite + commands.json)
pip install tensorflow
python tools/train_commands.py import-speech-commands --data data/commands
python tools/train_commands.py train --data data/commands --limit 3000 --augment 1 --epochs 25 --assets

# the corpus only has 7 of the 14 orders; record the rest in the room the robot will work in
python tools/train_commands.py record --label "Wave" --count 30 --data data/commands

# not in git (see .gitignore), so copy these into the tree by hand for an offline build:
#   app/src/main/assets/ggml-small.bin   whisper model, 487 MB
#   app/src/main/cpp/whisper.cpp/        git clone --depth 1 --branch v1.7.4 https://github.com/ggerganov/whisper.cpp

# speech (app/src/main/assets/moonshine/)
# The Voice page offers English only, and Moonshine has one model per language, downloaded with
# their python package:
#   pip install moonshine-voice
#   python -m moonshine_voice.download --language en --stt --model-arch 0   # tiny-en, 43 MB
#   copy encoder_model.ort decoder_model_merged.ort tokenizer.bin from the download cache into
#   assets/moonshine/tiny-en/
# MoonshineEngine still knows the Korean models (tiny-kp, then tiny-ko) and assets/moonshine/
# tiny-ko is still in git: put "ko" back in adv_language_codes/adv_language_options and Korean
# is offered again. Nothing selects it as it stands, so deleting that folder saves ~69 MB.
# --model-arch 1 is the base model (three times the size, a little more accurate): put it in
# assets/moonshine/base-en and name it in MoonshineEngine.java.
#
# LICENCES: the English models are MIT. tiny-ko is under Moonshine's Community Licence, which is
# non-commercial -- shipping it in a product needs their permission.
# The library itself comes from Maven (ai.moonshine:moonshine-voice) and needs minSdk 26.

# "OK" after a command is understood (app/src/main/assets/ok.wav)
# RobotService.acknowledge() plays that file whenever a command is recognised, on whichever page.
# What is in git is a placeholder: two short tones, generated, not a voice. Replace it with a
# recording of the word -- any mono WAV plays, and it is kept uncompressed in the APK
# (build.gradle noCompress). With the file removed the speech engine says the word instead.

# the robot link (Bluetooth Low Energy)
# The Remote Control page finds the robot, connects to it and hands the link to RobotSession, so
# every page's commands go out over it (com.falcon.robot.ble.BleLink). The robot is expected to
# offer the Nordic UART Service -- a serial link over BLE:
#   service 6e400001-b5a3-f393-e0a9-e50e24dcca9e
#   write   6e400002-b5a3-f393-e0a9-e50e24dcca9e   commands, one per line, UTF-8
#   notify  6e400003-b5a3-f393-e0a9-e50e24dcca9e   whatever the robot answers, into the log
# Change those UUIDs in BleLink.java if the firmware uses its own. Android 12 and newer ask for
# BLUETOOTH_SCAN and BLUETOOTH_CONNECT; older ones ask for the location permission instead.

# fine-tuning on your own recordings (the English model; --base for another)
pip install torch transformers "optimum[onnxruntime]" jiwer soundfile
python tools/train_moonshine.py scan   --data data/speech
python tools/train_moonshine.py train  --data data/speech --epochs 8
python tools/train_moonshine.py export --checkpoint out/moonshine --assets
python tools/train_moonshine.py check  --model app/src/main/assets/moonshine/tiny-en
