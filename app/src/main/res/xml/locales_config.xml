<?xml version="1.0" encoding="utf-8"?>
<!--
  Languages the app ships. Android 13 and newer use this to offer a per-app language in the
  system settings; the in-app picker (Settings → Language) works on every version.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="zh" />
    <locale android:name="ja" />
</locale-config>
