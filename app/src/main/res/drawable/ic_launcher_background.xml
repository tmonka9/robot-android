<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon background: the app's deep navy with the glow the UI uses behind the robot.
  Flat colours only, so it renders the same on every Android version (gradients in vector
  drawables need API 24).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#FF071426"
        android:pathData="M0,0h108v108h-108z" />
    <!-- glow behind the mark, in three steps so it reads as a soft light -->
    <path
        android:fillColor="#FF0E2A4E"
        android:pathData="M54,54m-44,0a44,44 0,1 1,88 0a44,44 0,1 1,-88 0" />
    <path
        android:fillColor="#FF123C6E"
        android:pathData="M54,54m-34,0a34,34 0,1 1,68 0a34,34 0,1 1,-68 0" />
    <path
        android:fillColor="#FF17538F"
        android:pathData="M54,54m-25,0a25,25 0,1 1,50 0a25,25 0,1 1,-50 0" />
</vector>
