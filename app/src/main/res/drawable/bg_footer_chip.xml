<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#FF16325E" />
            <stroke android:width="1.5dp" android:color="@color/blue" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient android:angle="0" android:startColor="#FF0A1630" android:endColor="#FF102650" />
            <stroke android:width="1.5dp" android:color="#FF2F5FB0" />
        </shape>
    </item>
</selector>
