<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#FF16408A" />
            <stroke android:width="1dp" android:color="#FF4FA8FF" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <gradient android:angle="270" android:startColor="#FF2F80FF" android:endColor="#FF1A4FD0" />
            <stroke android:width="1dp" android:color="#FF6FB5FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <gradient android:angle="270" android:startColor="#FF0F2448" android:endColor="#FF0A1832" />
            <stroke android:width="1dp" android:color="#FF24467E" />
        </shape>
    </item>
</selector>
