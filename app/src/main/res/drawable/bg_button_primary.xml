<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#FF1A4FD0" />
            <stroke android:width="1dp" android:color="#FF6FB5FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <gradient android:angle="270" android:startColor="#FF3A8CFF" android:endColor="#FF1A5AE0" />
            <stroke android:width="1dp" android:color="#FF6FB5FF" />
        </shape>
    </item>
</selector>
