<?xml version="1.0" encoding="utf-8"?>
<!-- Home feature card; bound in MainActivity#buildCardGrid. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/home_card_height"
    android:foreground="?android:attr/selectableItemBackground">

    <ImageView
        android:id="@+id/card_deco"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="top|end"
        android:layout_margin="10dp"
        android:alpha="0.16"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/card_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageView
            android:id="@+id/card_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@null" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/card_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:textColor="@color/white"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/card_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="44dp"
            android:maxLines="2"
            android:textColor="@color/white_80"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/card_arrow"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="14dp"
        android:background="@drawable/bg_arrow_circle"
        android:contentDescription="@null"
        android:padding="7dp"
        android:src="@drawable/ic_arrow_right" />

    <LinearLayout
        android:id="@+id/card_slogan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.25"
            android:lineSpacingExtra="6dp"
            android:text="@string/home_slogan"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <View
            android:layout_width="40dp"
            android:layout_height="2dp"
            android:layout_marginTop="14dp"
            android:background="@color/blue" />
    </LinearLayout>
</FrameLayout>
