<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/view_page_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <LinearLayout
                android:id="@+id/columns"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <!-- Camera preview placeholder; swap for a TextureView when the camera is wired up. -->
                <FrameLayout
                    android:id="@+id/face_preview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/preview_height"
                    android:background="@drawable/bg_face_preview"
                    android:tag="1.6">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="48dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_person" />

                    <ImageView
                        android:layout_width="180dp"
                        android:layout_height="180dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/face_frame" />

                    <View
                        android:id="@+id/face_scan_line"
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginLeft="16dp"
                        android:layout_marginRight="16dp"
                        android:background="@drawable/bg_scan_line"
                        android:visibility="invisible" />
                </FrameLayout>

                <LinearLayout
                    style="@style/Column"
                    android:tag="1">

                    <LinearLayout style="@style/Panel">

                        <TextView
                            style="@style/FieldLabel"
                            android:text="@string/status" />

                        <TextView
                            android:id="@+id/face_status"
                            style="@style/StatusText"
                            android:layout_marginTop="6dp"
                            android:drawableStart="@drawable/dot_teal"
                            android:text="@string/status_ready"
                            android:textColor="@color/teal" />
                    </LinearLayout>

                    <LinearLayout
                        style="@style/Panel"
                        android:layout_marginTop="@dimen/gap"
                        android:layout_weight="1">

                        <TextView
                            style="@style/FieldLabel"
                            android:text="@string/last_result" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/bg_avatar"
                                android:contentDescription="@null"
                                android:padding="7dp"
                                android:src="@drawable/ic_person" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/result_name"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/placeholder_value"
                                    android:textColor="@color/text_primary"
                                    android:textSize="14sp" />

                                <TextView
                                    android:id="@+id/result_match"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:fontFamily="sans-serif-medium"
                                    android:textColor="@color/teal"
                                    android:textSize="13sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            style="@style/FieldLabel"
                            android:layout_marginTop="12dp"
                            android:text="@string/time" />

                        <TextView
                            android:id="@+id/result_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/placeholder_value"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btn_scan_face"
                        style="@style/PrimaryButton"
                        android:layout_width="match_parent"
                        android:layout_marginTop="@dimen/gap"
                        android:drawableStart="@drawable/ic_scan"
                        android:text="@string/scan_face" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                style="@style/Panel"
                android:layout_marginTop="@dimen/gap">

                <TextView
                    style="@style/SectionTitle"
                    android:text="@string/face_database" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:scrollbars="none">

                    <!-- Filled by FaceRecognitionActivity#renderDatabase -->
                    <LinearLayout
                        android:id="@+id/face_db_row"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btn_add_user"
                        style="@style/ActionButton"
                        android:drawableTop="@drawable/ic_person_add"
                        android:text="@string/add_user" />

                    <TextView
                        android:id="@+id/btn_manage"
                        style="@style/ActionButton"
                        android:layout_marginStart="8dp"
                        android:drawableTop="@drawable/ic_database"
                        android:text="@string/manage" />

                    <TextView
                        android:id="@+id/btn_face_settings"
                        style="@style/ActionButton"
                        android:layout_marginStart="8dp"
                        android:drawableTop="@drawable/ic_settings"
                        android:text="@string/nav_settings" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
