<?xml version="1.0" encoding="utf-8"?>
<!-- Camera Settings dialog (Settings page); bound in SettingsActivity#showCameraDialog. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="24dp"
    android:paddingTop="12dp"
    android:paddingRight="24dp">

    <TextView
        style="@style/FieldLabel"
        android:text="@string/camera" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">

        <Spinner
            android:id="@+id/spinner_camera"
            style="@style/Dropdown"
            android:layout_height="44dp" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="8dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_dropdown" />
    </FrameLayout>

    <TextView
        style="@style/FieldLabel"
        android:layout_marginTop="12dp"
        android:text="@string/camera_resolution" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">

        <Spinner
            android:id="@+id/spinner_resolution"
            style="@style/Dropdown"
            android:layout_height="44dp" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="8dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_dropdown" />
    </FrameLayout>

    <TextView
        android:id="@+id/camera_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/camera_settings_note"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />
</LinearLayout>
