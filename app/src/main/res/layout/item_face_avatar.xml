<?xml version="1.0" encoding="utf-8"?>
<!-- One entry in the Face Database strip; bound in FaceRecognitionActivity#renderDatabase. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="80dp"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <FrameLayout
        android:layout_width="60dp"
        android:layout_height="60dp">

        <ImageView
            android:id="@+id/face_avatar"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="bottom|start"
            android:contentDescription="@null"
            android:padding="10dp" />

        <ImageView
            android:id="@+id/face_delete"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_delete_badge"
            android:contentDescription="@null"
            android:padding="4dp"
            android:src="@drawable/ic_close"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/face_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:singleLine="true"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />
</LinearLayout>
