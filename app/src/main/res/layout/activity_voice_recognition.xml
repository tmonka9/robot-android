<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/view_page_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/columns"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/screen_padding">

            <!-- Column 1: microphone -->
            <LinearLayout
                style="@style/Panel"
                android:background="@drawable/bg_panel_purple"
                android:gravity="center"
                android:tag="1.2">

                <FrameLayout
                    android:id="@+id/btn_mic"
                    android:layout_width="@dimen/mic_ring_size"
                    android:layout_height="@dimen/mic_ring_size"
                    android:layout_marginTop="16dp"
                    android:clickable="true"
                    android:contentDescription="@string/nav_voice"
                    android:focusable="true">

                    <View
                        android:id="@+id/mic_pulse"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_mic_ring_outer" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="20dp"
                        android:background="@drawable/bg_mic_ring_inner" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="42dp"
                        android:background="@drawable/bg_mic_core">

                        <ImageView
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_mic_large" />
                    </FrameLayout>
                </FrameLayout>

                <com.falcon.robot.widget.WaveformView
                    android:id="@+id/waveform"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="16dp" />

                <TextView
                    android:id="@+id/voice_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/status_listening"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="12dp"
                    android:text="@string/listening_hint"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Column 2: result + controls -->
            <LinearLayout
                style="@style/Column"
                android:tag="1">

                <LinearLayout
                    style="@style/Panel"
                    android:background="@drawable/bg_panel_purple">

                    <TextView
                        style="@style/SectionTitle"
                        android:text="@string/recognized_command" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_rec_card"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_avatar_purple"
                            android:contentDescription="@null"
                            android:padding="9dp"
                            android:src="@drawable/ic_mic_small" />

                        <TextView
                            android:id="@+id/recognized_text"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="@string/no_command_yet"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp" />

                        <com.falcon.robot.widget.WaveformView
                            android:id="@+id/recognized_wave"
                            android:layout_width="64dp"
                            android:layout_height="28dp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btn_voice_toggle"
                        style="@style/PrimaryButton"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_weight="1"
                        android:drawableStart="@drawable/ic_stop"
                        android:text="@string/stop" />

                    <TextView
                        android:id="@+id/btn_voice_settings"
                        style="@style/PrimaryButton"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_marginStart="@dimen/gap"
                        android:layout_weight="1"
                        android:drawableStart="@drawable/ic_settings"
                        android:text="@string/nav_settings" />
                </LinearLayout>

                <LinearLayout
                    style="@style/Panel"
                    android:layout_marginTop="@dimen/gap"
                    android:background="@drawable/bg_panel_purple"
                    android:layout_weight="1">

                    <TextView
                        style="@style/SectionTitle"
                        android:text="@string/try_saying" />

                    <!-- Filled by VoiceRecognitionActivity#buildCommandGrid -->
                    <LinearLayout
                        android:id="@+id/command_grid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
