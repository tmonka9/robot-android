<?xml version="1.0" encoding="utf-8"?>
<!--
  Voice Recognition page, following design/voice.png.
  Top row: Listening visual | Recognition Result | Voice Database.
  Bottom row: Voice Control | Voice Command History | Advanced Settings.
  Rows sit side by side on wide screens and stack otherwise (BaseActivity#setupColumns).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/view_page_header_rich" />

    <com.falcon.robot.widget.FitScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <!-- ======================= Top row ======================= -->
            <LinearLayout
                android:id="@+id/columns"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.05">

                <!-- Listening visual: artwork with live labels and waveform -->
                <FrameLayout
                    android:id="@+id/listen_panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_panel_robot"
                    android:minHeight="300dp"
                    android:tag="1.45">

                    <com.falcon.robot.widget.CoverImageView
                        android:id="@+id/voice_visual"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:src="@drawable/voice_visual" />

                    <View
                        android:id="@+id/mic_hit"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="@string/microphone"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/speak_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:textColor="@color/text_primary" />

                    <com.falcon.robot.widget.WaveformView
                        android:id="@+id/live_wave"
                        android:layout_width="0dp"
                        android:layout_height="0dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:id="@+id/listen_badge"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_icon_box">

                            <View
                                android:id="@+id/listen_dot"
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_gravity="center"
                                android:background="@drawable/dot_teal" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/listen_state"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/teal"
                            android:textSize="22sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/mic_selector"
                        android:layout_width="wrap_content"
                        android:layout_height="56dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="14dp"
                        android:background="@drawable/bg_title_chip"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingLeft="14dp"
                        android:paddingRight="10dp">

                        <ImageView
                            android:id="@+id/mic_selector_icon"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_mic" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/microphone"
                                android:textColor="@color/white"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/mic_device"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:singleLine="true"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginStart="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_dropdown" />
                    </LinearLayout>
                </FrameLayout>

                <!-- Recognition result + command action -->
                <LinearLayout
                    style="@style/RobotPanel"
                    android:tag="1.05">

                    <TextView
                        android:id="@+id/result_title"
                        style="@style/RobotPanelTitle"
                        android:text="@string/recognition_result"
                        android:textColor="@color/teal"
                        android:textSize="17sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_quote_box"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingLeft="14dp"
                        android:paddingRight="8dp">

                        <TextView
                            android:id="@+id/result_quote"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:singleLine="true"
                            android:textColor="@color/teal"
                            android:textSize="24sp" />

                        <ImageButton
                            android:id="@+id/btn_speak"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_box"
                            android:contentDescription="@string/text"
                            android:padding="9dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_volume_up" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout style="@style/VoiceInfoRow">

                            <TextView
                                style="@style/VoiceInfoLabel"
                                android:text="@string/text" />

                            <TextView
                                android:id="@+id/result_text"
                                style="@style/VoiceInfoValue" />
                        </LinearLayout>

                        <LinearLayout style="@style/VoiceInfoRow">

                            <TextView
                                style="@style/VoiceInfoLabel"
                                android:text="@string/confidence" />

                            <TextView
                                android:id="@+id/result_confidence"
                                style="@style/VoiceInfoValue"
                                android:layout_width="64dp"
                                android:layout_weight="0" />

                            <ProgressBar
                                android:id="@+id/result_confidence_bar"
                                style="@android:style/Widget.ProgressBar.Horizontal"
                                android:layout_width="0dp"
                                android:layout_height="7dp"
                                android:layout_weight="1"
                                android:max="1000"
                                android:progressDrawable="@drawable/progress_loading" />
                        </LinearLayout>

                        <LinearLayout style="@style/VoiceInfoRow">

                            <TextView
                                style="@style/VoiceInfoLabel"
                                android:text="@string/language" />

                            <TextView
                                android:id="@+id/result_language"
                                style="@style/VoiceInfoValue" />
                        </LinearLayout>

                        <LinearLayout style="@style/VoiceInfoRow">

                            <TextView
                                style="@style/VoiceInfoLabel"
                                android:text="@string/time" />

                            <TextView
                                android:id="@+id/result_time"
                                style="@style/VoiceInfoValue" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="4dp"
                        android:background="@color/divider" />

                    <TextView
                        android:id="@+id/action_title"
                        style="@style/RobotPanelTitle"
                        android:layout_marginTop="4dp"
                        android:text="@string/command_action"
                        android:textColor="@color/teal" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="66dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_table_box"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="8dp">

                        <FrameLayout
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:background="@drawable/bg_icon_box">

                            <ImageView
                                android:id="@+id/action_icon"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/action_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:singleLine="true"
                                android:textColor="@color/white"
                                android:textSize="15sp" />

                            <TextView
                                android:id="@+id/action_desc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:singleLine="true"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <ImageButton
                            android:id="@+id/btn_execute"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_icon_box"
                            android:contentDescription="@string/execute_label"
                            android:padding="9dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_arrow_right" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Voice database -->
                <LinearLayout
                    style="@style/RobotPanel"
                    android:tag="0.78">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/voice_db_title"
                            style="@style/RobotPanelTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/voice_database" />

                        <TextView
                            android:id="@+id/btn_add_voice"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_control_button"
                            android:clickable="true"
                            android:drawablePadding="6dp"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingLeft="10dp"
                            android:paddingRight="12dp"
                            android:singleLine="true"
                            android:text="@string/add_voice"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/voice_search"
                        style="@style/Input"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="8dp"
                        android:drawablePadding="10dp"
                        android:hint="@string/search_by_name"
                        android:imeOptions="actionSearch"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:textSize="13sp" />

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="8dp"
                        android:layout_weight="1"
                        android:minHeight="200dp"
                        android:nestedScrollingEnabled="true"
                        android:scrollbars="none">

                        <!-- Filled by VoiceRecognitionActivity#renderProfiles -->
                        <LinearLayout
                            android:id="@+id/voice_db_list"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </ScrollView>
                </LinearLayout>
            </LinearLayout>

            <!-- ======================= Bottom row ======================= -->
            <LinearLayout
                android:id="@+id/columns_bottom"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/gap"
                android:layout_weight="1">

                <!-- Voice control -->
                <LinearLayout
                    style="@style/RobotPanel"
                    android:tag="1">

                    <TextView
                        android:id="@+id/control_title"
                        style="@style/RobotPanelTitle"
                        android:text="@string/voice_control" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="6dp"
                        android:background="@color/divider" />

                    <!-- Filled by VoiceRecognitionActivity#setupVoiceControl -->
                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/voice_toggles"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </ScrollView>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/wake_word"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingLeft="14dp">

                        <TextView
                            android:id="@+id/wake_word"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:singleLine="true"
                            android:textColor="@color/white"
                            android:textSize="14sp" />

                        <ImageButton
                            android:id="@+id/btn_edit_wake"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="?android:attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/wake_word"
                            android:padding="11dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_edit" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Voice command history -->
                <LinearLayout
                    style="@style/RobotPanel"
                    android:tag="1.1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/history_title"
                            style="@style/RobotPanelTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/voice_history" />

                        <TextView
                            android:id="@+id/btn_clear_history"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_control_button"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingLeft="16dp"
                            android:paddingRight="16dp"
                            android:text="@string/clear"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="34dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_table_box"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingLeft="12dp"
                        android:paddingRight="8dp">

                        <TextView
                            style="@style/VoiceHistoryCell"
                            android:layout_weight="1.55"
                            android:text="@string/time" />

                        <TextView
                            style="@style/VoiceHistoryCell"
                            android:layout_weight="1.2"
                            android:text="@string/command" />

                        <TextView
                            style="@style/VoiceHistoryCell"
                            android:layout_weight="0.9"
                            android:text="@string/result" />

                        <TextView
                            style="@style/VoiceHistoryCell"
                            android:layout_weight="0.9"
                            android:text="@string/confidence" />
                    </LinearLayout>

                    <!-- Filled by VoiceRecognitionActivity#renderHistory -->
                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/voice_history_list"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </ScrollView>
                </LinearLayout>

                <!-- Advanced settings -->
                <LinearLayout
                    style="@style/RobotPanel"
                    android:tag="1.1">

                    <TextView
                        android:id="@+id/advanced_title"
                        style="@style/RobotPanelTitle"
                        android:text="@string/advanced_settings" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="6dp"
                        android:background="@color/divider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/adv_tab_language"
                            style="@style/SettingsTab"
                            android:layout_marginStart="0dp"
                            android:text="@string/tab_language" />

                        <TextView
                            android:id="@+id/adv_tab_hotword"
                            style="@style/SettingsTab"
                            android:text="@string/tab_hotword" />

                        <TextView
                            android:id="@+id/adv_tab_audio"
                            style="@style/SettingsTab"
                            android:text="@string/tab_audio" />
                    </LinearLayout>

                    <!-- Filled by VoiceRecognitionActivity#renderAdvancedTab -->
                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="4dp"
                        android:layout_weight="1"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/adv_rows"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </ScrollView>

                    <TextView
                        android:id="@+id/btn_apply_settings"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_button_primary"
                        android:clickable="true"
                        android:drawablePadding="8dp"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="@string/apply_settings"
                        android:textColor="@color/white"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.falcon.robot.widget.FitScrollView>
</LinearLayout>
