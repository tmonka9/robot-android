<?xml version="1.0" encoding="utf-8"?>
<!-- Home page content (inside the shell). -->
<com.falcon.robot.widget.FitScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <!-- Hero and status panel: side by side on wide screens (BaseActivity#setupColumns). -->
        <LinearLayout
            android:id="@+id/columns"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Banner artwork from design/home.png; the title and robot always stay visible. -->
            <FrameLayout
                android:id="@+id/hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero_frame"
                android:minHeight="@dimen/hero_min_height"
                android:tag="2.3">

                <com.falcon.robot.widget.CoverImageView
                    android:id="@+id/hero_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/home_hero" />
            </FrameLayout>

            <!-- Status panel -->
            <LinearLayout
                style="@style/Panel"
                android:padding="16dp"
                android:tag="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/home_system_status"
                        style="@style/StatusText"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextClock
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:format12Hour="h:mm"
                            android:format24Hour="HH:mm"
                            android:textColor="@color/text_primary"
                            android:textSize="24sp" />

                        <TextClock
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:format12Hour="@string/date_format"
                            android:format24Hour="@string/date_format"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Network / battery -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_status_box"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:id="@+id/status_wifi"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:contentDescription="@string/wifi"
                        android:src="@drawable/ic_wifi" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/FieldLabel"
                            android:text="@string/network" />

                        <TextView
                            android:id="@+id/home_network"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/teal"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="36dp"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="10dp"
                        android:background="@color/divider" />

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_battery_h" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/FieldLabel"
                            android:text="@string/battery" />

                        <TextView
                            android:id="@+id/status_battery"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                        <ProgressBar
                            android:id="@+id/home_battery_bar"
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_marginTop="4dp"
                            android:max="100"
                            android:progressDrawable="@drawable/progress_battery" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Quick status; rows filled by MainActivity#buildQuickStatus -->
                <LinearLayout
                    android:id="@+id/quick_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_status_box"
                    android:orientation="vertical"
                    android:paddingLeft="14dp"
                    android:paddingTop="10dp"
                    android:paddingRight="8dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:drawableStart="@drawable/ic_check_circle"
                        android:drawablePadding="10dp"
                        android:gravity="center_vertical"
                        android:text="@string/quick_status"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Feature cards; filled by MainActivity#buildCardGrid. Cards keep the artwork's aspect ratio; the banner row takes the remaining height. -->
        <LinearLayout
            android:id="@+id/home_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap"
            android:orientation="vertical" />
    </LinearLayout>
</com.falcon.robot.widget.FitScrollView>
