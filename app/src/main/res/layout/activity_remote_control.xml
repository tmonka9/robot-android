<?xml version="1.0" encoding="utf-8"?>
<!--
  Remote Control page, following design/remote.png.
  Top row: Camera View | Robot Status | Map View.
  Bottom row: BLE Connection | Camera & Recording, Operation Log.
  Rows sit side by side on wide screens and stack otherwise (BaseActivity#setupColumns).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/view_page_header_rich" />

    <com.falcon.robot.widget.FitScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <!-- ======================= Top row ======================= -->
            <LinearLayout
                android:id="@+id/columns"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.08">

                <!-- Camera view -->
                <LinearLayout
                    android:id="@+id/panel_camera"
                    style="@style/RobotPanel"
                    android:tag="1.5">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/camera_title"
                            style="@style/RobotPanelTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:singleLine="true" />

                        <TextView
                            android:id="@+id/cam_front"
                            style="@style/CameraTab"
                            android:layout_height="30dp"
                            android:paddingLeft="10dp"
                            android:paddingRight="10dp"
                            android:text="@string/cam_front"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/cam_rear"
                            style="@style/CameraTab"
                            android:layout_height="30dp"
                            android:paddingLeft="10dp"
                            android:paddingRight="10dp"
                            android:text="@string/cam_rear"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/cam_left"
                            style="@style/CameraTab"
                            android:layout_height="30dp"
                            android:paddingLeft="10dp"
                            android:paddingRight="10dp"
                            android:text="@string/cam_left"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/cam_right"
                            style="@style/CameraTab"
                            android:layout_height="30dp"
                            android:paddingLeft="10dp"
                            android:paddingRight="10dp"
                            android:text="@string/cam_right"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Feed placeholder (design artwork); replace with the robot camera stream. -->
                    <FrameLayout
                        android:id="@+id/feed_frame"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_table_box"
                        android:minHeight="240dp">

                        <com.falcon.robot.widget.CoverImageView
                            android:id="@+id/camera_feed"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/camera_view"
                            android:src="@drawable/remote_camera_front" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|end"
                            android:layout_margin="10dp"
                            android:orientation="vertical">

                            <ImageButton
                                android:id="@+id/tool_photo"
                                style="@style/ViewTool"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:contentDescription="@string/take_photo"
                                android:src="@drawable/ic_camera" />

                            <ImageButton
                                android:id="@+id/tool_switch"
                                style="@style/ViewTool"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_marginTop="6dp"
                                android:contentDescription="@string/switch_camera"
                                android:src="@drawable/ic_refresh" />

                            <ImageButton
                                android:id="@+id/tool_fullscreen"
                                style="@style/ViewTool"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_marginTop="6dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_fullscreen" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/camera_info"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|start"
                            android:layout_margin="10dp"
                            android:background="@drawable/bg_feed_label"
                            android:paddingLeft="10dp"
                            android:paddingTop="4dp"
                            android:paddingRight="10dp"
                            android:paddingBottom="4dp"
                            android:textColor="@color/white"
                            android:textSize="12sp" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Robot status -->
                <LinearLayout
                    style="@style/RobotPanel"
                    android:tag="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/status_title"
                            style="@style/RobotPanelTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/robot_status" />

                        <TextView
                            android:id="@+id/status_online"
                            style="@style/StatusText"
                            android:layout_marginEnd="6dp"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1.35"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout style="@style/RemoteStatusRow">

                                <TextView
                                    android:id="@+id/label_mode"
                                    style="@style/StatusRowLabel"
                                    android:text="@string/mode" />

                                <TextView
                                    android:id="@+id/value_mode"
                                    style="@style/RemoteStatusValue" />
                            </LinearLayout>

                            <LinearLayout style="@style/RemoteStatusRow">

                                <TextView
                                    android:id="@+id/label_speed"
                                    style="@style/StatusRowLabel"
                                    android:text="@string/speed" />

                                <TextView
                                    android:id="@+id/value_speed"
                                    style="@style/RemoteStatusValue" />
                            </LinearLayout>

                            <LinearLayout style="@style/RemoteStatusRow">

                                <TextView
                                    android:id="@+id/label_battery"
                                    style="@style/StatusRowLabel"
                                    android:text="@string/battery" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/value_battery"
                                        style="@style/RemoteStatusValue"
                                        android:layout_width="wrap_content"
                                        android:layout_weight="0" />

                                    <ProgressBar
                                        android:id="@+id/bar_battery"
                                        style="@android:style/Widget.ProgressBar.Horizontal"
                                        android:layout_width="match_parent"
                                        android:layout_height="6dp"
                                        android:layout_marginTop="3dp"
                                        android:layout_marginEnd="8dp"
                                        android:max="100"
                                        android:progressDrawable="@drawable/progress_battery" />
                                </LinearLayout>
                            </LinearLayout>

                            <LinearLayout style="@style/RemoteStatusRow">

                                <TextView
                                    android:id="@+id/label_temperature"
                                    style="@style/StatusRowLabel"
                                    android:text="@string/temperature" />

                                <TextView
                                    android:id="@+id/value_temperature"
                                    style="@style/RemoteStatusValue" />
                            </LinearLayout>

                            <LinearLayout style="@style/RemoteStatusRow">

                                <TextView
                                    android:id="@+id/label_connection"
                                    style="@style/StatusRowLabel"
                                    android:text="@string/connection" />

                                <TextView
                                    android:id="@+id/value_connection"
                                    style="@style/RemoteStatusValue" />
                            </LinearLayout>
                        </LinearLayout>

                        <ImageView
                            android:layout_width="84dp"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter"
                            android:src="@drawable/remote_status_robot" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="4dp"
                        android:background="@color/divider" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginTop="6dp"
                        android:text="@string/position_estimated"
                        android:textColor="@color/blue_light"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:minHeight="90dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="6dp">

                            <LinearLayout style="@style/PoseRow">

                                <TextView
                                    style="@style/PoseLabel"
                                    android:text="X" />

                                <TextView
                                    android:id="@+id/pos_x"
                                    style="@style/PoseValue" />
                            </LinearLayout>

                            <LinearLayout style="@style/PoseRow">

                                <TextView
                                    style="@style/PoseLabel"
                                    android:text="Y" />

                                <TextView
                                    android:id="@+id/pos_y"
                                    style="@style/PoseValue" />
                            </LinearLayout>

                            <LinearLayout style="@style/PoseRow">

                                <TextView
                                    style="@style/PoseLabel"
                                    android:text="Z" />

                                <TextView
                                    android:id="@+id/pos_z"
                                    style="@style/PoseValue" />
                            </LinearLayout>
                        </LinearLayout>

                        <com.falcon.robot.widget.CompassView
                            android:id="@+id/compass"
                            android:layout_width="96dp"
                            android:layout_height="96dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Map view -->
                <LinearLayout
                    style="@style/RobotPanel"
                    android:tag="0.95">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/map_title"
                            style="@style/RobotPanelTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/view_map"
                            android:textColor="@color/blue_light" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_segment_group"
                            android:orientation="horizontal"
                            android:padding="2dp">

                            <TextView
                                android:id="@+id/map_2d_tab"
                                android:layout_width="48dp"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_segment"
                                android:gravity="center"
                                android:text="@string/map_2d"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/map_3d_tab"
                                android:layout_width="48dp"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_segment"
                                android:gravity="center"
                                android:text="@string/map_3d"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/map_frame"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_table_box"
                        android:minHeight="220dp">

                        <ImageView
                            android:id="@+id/map_image"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/view_map"
                            android:scaleType="fitCenter"
                            android:src="@drawable/remote_map_2d" />

                        <com.falcon.robot.widget.LidarMapView
                            android:id="@+id/map_live"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|end"
                            android:layout_margin="8dp"
                            android:orientation="vertical">

                            <ImageButton
                                android:id="@+id/map_zoom_in"
                                style="@style/ViewTool"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:contentDescription="@null"
                                android:padding="8dp"
                                android:src="@drawable/ic_add" />

                            <ImageButton
                                android:id="@+id/map_zoom_out"
                                style="@style/ViewTool"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_marginTop="6dp"
                                android:contentDescription="@null"
                                android:padding="8dp"
                                android:src="@drawable/ic_remove" />

                            <ImageButton
                                android:id="@+id/map_locate"
                                style="@style/ViewTool"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_marginTop="6dp"
                                android:contentDescription="@null"
                                android:padding="8dp"
                                android:src="@drawable/ic_crosshair" />
                        </LinearLayout>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="32dp"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/legend_robot"
                            style="@style/LegendItem"
                            android:text="@string/legend_robot" />

                        <TextView
                            style="@style/LegendItem"
                            android:drawableStart="@drawable/legend_path"
                            android:text="@string/legend_path" />

                        <TextView
                            style="@style/LegendItem"
                            android:drawableStart="@drawable/legend_target"
                            android:text="@string/legend_target" />

                        <TextView
                            style="@style/LegendItem"
                            android:drawableStart="@drawable/legend_obstacle"
                            android:text="@string/legend_obstacle" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ======================= Bottom row ======================= -->
            <LinearLayout
                android:id="@+id/columns_bottom"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/gap"
                android:layout_weight="1">

                <!-- BLE connection: how the Remote Control page reaches the robot -->
                <LinearLayout
                    style="@style/RobotPanel"
                    android:tag="1">

                    <TextView
                        android:id="@+id/ble_title"
                        style="@style/RobotPanelTitle"
                        android:text="@string/ble_connection" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="6dp"
                        android:background="@color/divider" />

                    <TextView
                        android:id="@+id/ble_status"
                        style="@style/StatusText"
                        android:layout_marginTop="10dp"
                        android:text="@string/ble_disconnected"
                        android:textColor="@color/text_secondary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/ble_scan"
                            style="@style/QuickButton"
                            android:minHeight="0dp"
                            android:text="@string/ble_scan" />

                        <TextView
                            android:id="@+id/ble_disconnect"
                            style="@style/QuickButton"
                            android:layout_marginStart="8dp"
                            android:minHeight="0dp"
                            android:text="@string/ble_disconnect" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/ble_devices_label"
                        style="@style/SettingLabel"
                        android:layout_marginTop="14dp"
                        android:text="@string/ble_devices" />

                    <!-- the list is filled by RemoteControlActivity, a row per device found -->
                    <com.falcon.robot.widget.PanelScrollView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="6dp"
                        android:layout_weight="1"
                        android:minHeight="120dp"
                        android:scrollbars="vertical">

                        <LinearLayout
                            android:id="@+id/ble_list"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </com.falcon.robot.widget.PanelScrollView>
                </LinearLayout>

                <!-- Camera & recording, log -->
                <LinearLayout
                    style="@style/Column"
                    android:tag="1">

                    <LinearLayout style="@style/RobotPanel">

                        <TextView
                            android:id="@+id/recording_title"
                            style="@style/RobotPanelTitle"
                            android:text="@string/camera_recording"
                            android:textColor="@color/blue_light" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/rec_photo"
                                style="@style/RecordButton"
                                android:layout_marginStart="0dp"
                                android:text="@string/take_photo" />

                            <TextView
                                android:id="@+id/rec_video"
                                style="@style/RecordButton"
                                android:text="@string/start_video" />

                            <TextView
                                android:id="@+id/rec_audio"
                                style="@style/RecordButton"
                                android:text="@string/record" />

                            <TextView
                                android:id="@+id/rec_gallery"
                                style="@style/RecordButton"
                                android:text="@string/gallery" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        style="@style/RobotPanel"
                        android:layout_height="0dp"
                        android:layout_marginTop="@dimen/gap"
                        android:layout_weight="1"
                        android:minHeight="120dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/log_title"
                                style="@style/RobotPanelTitle"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:text="@string/operation_log"
                                android:textColor="@color/blue_light" />

                            <TextView
                                android:id="@+id/btn_clear_log"
                                android:layout_width="wrap_content"
                                android:layout_height="30dp"
                                android:background="@drawable/bg_control_button"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center"
                                android:paddingLeft="16dp"
                                android:paddingRight="16dp"
                                android:text="@string/clear"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <ScrollView
                            android:id="@+id/log_scroll"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginTop="4dp"
                            android:layout_weight="1"
                            android:nestedScrollingEnabled="true">

                            <!-- Filled by BaseActivity#appendLog -->
                            <LinearLayout
                                android:id="@+id/log_list"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical" />
                        </ScrollView>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.falcon.robot.widget.FitScrollView>
</LinearLayout>
