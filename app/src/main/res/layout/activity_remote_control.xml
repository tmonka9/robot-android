<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/view_page_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <LinearLayout style="@style/Panel">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_segment_group"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/tab_joystick"
                        style="@style/Segment"
                        android:text="@string/tab_joystick" />

                    <TextView
                        android:id="@+id/tab_buttons"
                        style="@style/Segment"
                        android:layout_marginStart="4dp"
                        android:text="@string/tab_buttons" />
                </LinearLayout>

                <TextView
                    android:id="@+id/drive_status"
                    style="@style/StatusText"
                    android:layout_marginTop="12dp"
                    android:drawableStart="@drawable/dot_amber"
                    android:text="@string/status_idle"
                    android:textColor="@color/text_primary" />

                <LinearLayout
                    android:id="@+id/joystick_panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <com.falcon.robot.widget.JoystickView
                            android:id="@+id/joy_move"
                            android:layout_width="@dimen/joystick_size"
                            android:layout_height="@dimen/joystick_size" />

                        <TextView
                            style="@style/FieldLabel"
                            android:layout_marginTop="6dp"
                            android:text="@string/joystick_move" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <com.falcon.robot.widget.JoystickView
                            android:id="@+id/joy_turn"
                            android:layout_width="@dimen/joystick_size"
                            android:layout_height="@dimen/joystick_size" />

                        <TextView
                            style="@style/FieldLabel"
                            android:layout_marginTop="6dp"
                            android:text="@string/joystick_turn" />
                    </LinearLayout>
                </LinearLayout>

                <com.falcon.robot.widget.DPadView
                    android:id="@+id/drive_pad"
                    android:layout_width="@dimen/dpad_size"
                    android:layout_height="@dimen/dpad_size"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                style="@style/Panel"
                android:layout_marginTop="@dimen/gap">

                <TextView
                    style="@style/SectionTitle"
                    android:text="@string/quick_actions" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/act_forward"
                        style="@style/ActionButton"
                        android:drawableTop="@drawable/ic_arrow_up"
                        android:text="@string/act_forward" />

                    <TextView
                        android:id="@+id/act_backward"
                        style="@style/ActionButton"
                        android:layout_marginStart="8dp"
                        android:drawableTop="@drawable/ic_arrow_down"
                        android:text="@string/act_backward" />

                    <TextView
                        android:id="@+id/act_left"
                        style="@style/ActionButton"
                        android:layout_marginStart="8dp"
                        android:drawableTop="@drawable/ic_arrow_left"
                        android:text="@string/act_left" />

                    <TextView
                        android:id="@+id/act_right"
                        style="@style/ActionButton"
                        android:layout_marginStart="8dp"
                        android:drawableTop="@drawable/ic_arrow_right"
                        android:text="@string/act_right" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/act_stop"
                        style="@style/ActionButton"
                        android:drawableTop="@drawable/ic_stop"
                        android:text="@string/act_stop" />

                    <TextView
                        android:id="@+id/act_home"
                        style="@style/ActionButton"
                        android:layout_marginStart="8dp"
                        android:drawableTop="@drawable/ic_home"
                        android:text="@string/act_home" />

                    <TextView
                        android:id="@+id/act_turbo"
                        style="@style/ActionButton"
                        android:layout_marginStart="8dp"
                        android:drawableTop="@drawable/ic_bolt"
                        android:text="@string/act_turbo" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
