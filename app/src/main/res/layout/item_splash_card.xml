<?xml version="1.0" encoding="utf-8"?>
<!-- Splash feature card (decorative); bound in SplashActivity#buildCards. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/splash_card_height">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <ImageView
            android:id="@+id/card_icon"
            android:layout_width="@dimen/splash_card_icon"
            android:layout_height="@dimen/splash_card_icon"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:contentDescription="@null" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/card_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:textColor="@color/white"
            android:textSize="@dimen/splash_card_title" />

        <TextView
            android:id="@+id/card_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="30dp"
            android:maxLines="2"
            android:textColor="@color/white_80"
            android:textSize="@dimen/splash_card_desc" />
    </LinearLayout>

    <ImageView
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="12dp"
        android:background="@drawable/bg_arrow_circle"
        android:contentDescription="@null"
        android:padding="6dp"
        android:src="@drawable/ic_arrow_right" />
</FrameLayout>
