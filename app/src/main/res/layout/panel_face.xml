<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_panel_teal"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_face_scan" />

        <TextView
            style="@style/PanelTitle"
            android:text="@string/facial_recognition" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_panel_divider" />

    <TextView
        android:id="@+id/face_status"
        style="@style/StatusText"
        android:layout_marginTop="10dp"
        android:drawableStart="@drawable/dot_teal"
        android:text="@string/status_ready"
        android:textColor="@color/teal" />

    <!-- Camera preview placeholder; swap for a TextureView/PreviewView when the camera is wired up. -->
    <FrameLayout
        android:id="@+id/face_preview"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_face_preview">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_person" />

        <ImageView
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/face_frame" />

        <View
            android:id="@+id/face_scan_line"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:background="@drawable/bg_scan_line"
            android:visibility="invisible" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/btn_scan_face"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_scan_button"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:drawableStart="@drawable/ic_scan"
            android:drawablePadding="10dp"
            android:gravity="center_vertical"
            android:text="@string/scan_face"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />
    </FrameLayout>

    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_panel_divider" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/recognized"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_avatar"
            android:contentDescription="@null"
            android:padding="6dp"
            android:src="@drawable/ic_person" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/face_user"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/demo_user"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/match_label"
                    android:textColor="@color/teal"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/face_match"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/match_value"
                    android:textColor="@color/teal"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
