<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/view_page_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/columns"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/screen_padding">

            <!-- Column 1: camera/robot view + movement -->
            <LinearLayout
                style="@style/Column"
                android:tag="1.3">

                <LinearLayout style="@style/Panel">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/robot_preview_height"
                        android:background="@drawable/bg_preview">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_glow_blue" />

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:padding="12dp"
                            android:src="@drawable/img_robot" />
                    </FrameLayout>

                    <TextView
                        style="@style/SectionTitle"
                        android:layout_marginTop="14dp"
                        android:text="@string/movement_control" />

                    <com.falcon.robot.widget.DPadView
                        android:id="@+id/dpad"
                        android:layout_width="@dimen/dpad_size"
                        android:layout_height="@dimen/dpad_size"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="8dp" />

                    <TextView
                        style="@style/FieldLabel"
                        android:layout_marginTop="14dp"
                        android:text="@string/speed" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <SeekBar
                            android:id="@+id/speed_seek"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="100"
                            android:maxHeight="4dp"
                            android:minHeight="4dp"
                            android:paddingStart="4dp"
                            android:paddingEnd="12dp"
                            android:progress="60"
                            android:progressDrawable="@drawable/progress_loading"
                            android:splitTrack="false"
                            android:thumb="@drawable/seekbar_thumb" />

                        <TextView
                            android:id="@+id/speed_value"
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Column 2: status + actions -->
            <LinearLayout
                style="@style/Column"
                android:tag="1">

                <LinearLayout style="@style/Panel">

                    <TextView
                        android:id="@+id/robot_connection"
                        style="@style/StatusText"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:drawableStart="@drawable/dot_gray"
                        android:textColor="@color/text_primary" />

                    <View style="@style/PanelDivider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/battery"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/robot_battery"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <View style="@style/PanelDivider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/mode"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                        <FrameLayout
                            android:layout_width="160dp"
                            android:layout_height="wrap_content">

                            <Spinner
                                android:id="@+id/robot_mode"
                                style="@style/Dropdown" />

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="end|center_vertical"
                                android:layout_marginEnd="8dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_dropdown" />
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    style="@style/Panel"
                    android:layout_marginTop="@dimen/gap">

                    <TextView
                        style="@style/SectionTitle"
                        android:text="@string/actions" />

                    <TextView
                        android:id="@+id/action_stand"
                        style="@style/ListAction"
                        android:drawableStart="@drawable/ic_pose_stand"
                        android:text="@string/pose_stand" />

                    <TextView
                        android:id="@+id/action_sit"
                        style="@style/ListAction"
                        android:drawableStart="@drawable/ic_pose_sit"
                        android:text="@string/pose_sit" />

                    <TextView
                        android:id="@+id/action_wave"
                        style="@style/ListAction"
                        android:drawableStart="@drawable/ic_pose_wave"
                        android:text="@string/pose_wave" />

                    <TextView
                        android:id="@+id/action_dance"
                        style="@style/ListAction"
                        android:drawableStart="@drawable/ic_music"
                        android:text="@string/pose_dance" />

                    <TextView
                        android:id="@+id/robot_status"
                        style="@style/StatusText"
                        android:layout_marginTop="12dp"
                        android:text="@string/status_idle"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
