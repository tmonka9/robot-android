<?xml version="1.0" encoding="utf-8"?>
<!--
  Robot Control page: the screen the robot is driven from.
  Top row: the robot in 3D | the camera feed with the AI switches. Bottom row: the LiDAR map (kept
  as wide as the robot above it), Camera Settings and the Log. The actions live in a sidebar down
  the right-hand side and a status bar runs along the foot; both sit outside the scrolling page, so
  they are always in reach.
  Rows are arranged side by side on wide screens and stacked otherwise (BaseActivity#setupColumns);
  icons, sizes and state are bound in RobotControlActivity. There is deliberately no page header:
  the space goes to the panels.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <com.falcon.robot.widget.FitScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/screen_padding">

                <!-- ======================= Top row ======================= -->
                <LinearLayout
                    android:id="@+id/columns"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1.1">
                    <!-- Robot Status: robot artwork with live status overlays -->
                    <FrameLayout
                        android:id="@+id/robot_status_panel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_panel_robot"
                        android:minHeight="280dp"
                        android:tag="1">

                        <!-- the robot as a model you can turn with a finger -->
                        <com.falcon.robot.widget.Robot3DView
                            android:id="@+id/robot_3d"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start|top"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:id="@+id/robot_status_title"
                                android:layout_width="wrap_content"
                                android:layout_height="42dp"
                                android:background="@drawable/bg_title_chip"
                                android:clickable="true"
                                android:drawablePadding="12dp"
                                android:focusable="true"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="center_vertical"
                                android:paddingLeft="16dp"
                                android:paddingRight="20dp"
                                android:text="@string/robot_status"
                                android:textColor="@color/white"
                                android:textSize="16sp" />

                            <LinearLayout
                                android:id="@+id/robot_status_table"
                                android:layout_width="230dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:background="@drawable/bg_table_box"
                                android:orientation="vertical"
                                android:paddingLeft="12dp"
                                android:paddingRight="12dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="40dp"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/label_mode"
                                        style="@style/StatusRowLabel"
                                        android:text="@string/mode" />

                                    <TextView
                                        android:id="@+id/value_mode"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:singleLine="true"
                                        android:textColor="@color/text_primary"
                                        android:textSize="13sp" />
                                </LinearLayout>

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="1dp"
                                    android:background="@color/divider" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="40dp"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/label_speed"
                                        style="@style/StatusRowLabel"
                                        android:text="@string/speed" />

                                    <TextView
                                        android:id="@+id/value_speed"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:singleLine="true"
                                        android:textColor="@color/text_primary"
                                        android:textSize="13sp" />
                                </LinearLayout>

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="1dp"
                                    android:background="@color/divider" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="40dp"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/label_battery"
                                        style="@style/StatusRowLabel"
                                        android:text="@string/battery" />

                                    <TextView
                                        android:id="@+id/value_battery"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:singleLine="true"
                                        android:textColor="@color/text_primary"
                                        android:textSize="13sp" />
                                </LinearLayout>

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="1dp"
                                    android:background="@color/divider" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="40dp"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/label_temperature"
                                        style="@style/StatusRowLabel"
                                        android:text="@string/temperature" />

                                    <TextView
                                        android:id="@+id/value_temperature"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:singleLine="true"
                                        android:textColor="@color/text_primary"
                                        android:textSize="13sp" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/robot_position"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end|top"
                            android:layout_marginTop="80dp"
                            android:layout_marginEnd="18dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/position"
                                android:textColor="@color/blue_light"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/position_x"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/position_y"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/position_z"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <!-- panel controls: fill the page with the robot, or fold the panel away -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end|top"
                            android:layout_marginTop="10dp"
                            android:layout_marginEnd="10dp"
                            android:orientation="horizontal">

                            <ImageButton
                                android:id="@+id/robot_fullscreen"
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:background="?android:attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/full_screen"
                                android:padding="5dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_fullscreen" />

                            <ImageButton
                                android:id="@+id/robot_collapse"
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_marginStart="2dp"
                                android:background="?android:attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/collapse"
                                android:padding="5dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_chevron_up" />
                        </LinearLayout>
                    </FrameLayout>

                    <!--
                      Camera and AI in one panel: the feed, the three recognition switches under it,
                      and a line saying what is running. Face and object results are drawn on the feed.
                    -->
                    <LinearLayout
                        android:id="@+id/camera_panel"
                        style="@style/RobotPanel"
                        android:tag="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/camera_title"
                                style="@style/RobotPanelTitle"
                                android:layout_width="wrap_content"
                                android:text="@string/panel_camera_ai" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <ImageButton
                                android:id="@+id/camera_fullscreen"
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_marginStart="6dp"
                                android:background="?android:attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/full_screen"
                                android:padding="5dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_fullscreen" />
                        </LinearLayout>

                        <!--
                          The live camera, with the design artwork behind it until frames arrive.
                          The preview runs in COMPATIBLE mode so it is a view in the hierarchy
                          rather than its own surface: the artwork shows through it while it is
                          empty, and the robot overlay sits on top of it.
                        -->
                        <FrameLayout
                            android:id="@+id/camera_feed_frame"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginTop="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_table_box"
                            android:minHeight="200dp">

                            <com.falcon.robot.widget.CoverImageView
                                android:id="@+id/camera_feed"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/camera_view"
                                android:src="@drawable/robot_camera_front" />

                            <androidx.camera.view.PreviewView
                                android:id="@+id/camera_preview"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />

                            <com.falcon.robot.widget.TrackingOverlayView
                                android:id="@+id/tracking_overlay"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />

                            <com.falcon.robot.widget.FaceOverlayView
                                android:id="@+id/face_overlay"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />

                            <!--
                              Recording, over the top right corner: the red button starts and
                              stops it, Open lists what has been recorded.
                            -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="top|end"
                                android:layout_margin="8dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageButton
                                    android:id="@+id/camera_open"
                                    android:layout_width="34dp"
                                    android:layout_height="34dp"
                                    android:layout_marginEnd="8dp"
                                    android:background="@drawable/bg_feed_button"
                                    android:contentDescription="@string/open_recordings"
                                    android:padding="7dp"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/ic_folder_open" />

                                <ImageButton
                                    android:id="@+id/camera_record"
                                    android:layout_width="34dp"
                                    android:layout_height="34dp"
                                    android:background="@drawable/bg_feed_button"
                                    android:contentDescription="@string/record_video"
                                    android:padding="4dp"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/ic_record_dot" />
                            </LinearLayout>

                            <!-- which camera the feed comes from; tapping it offers the others -->
                            <TextView
                                android:id="@+id/camera_source"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom|end"
                                android:layout_margin="10dp"
                                android:background="@drawable/bg_feed_label"
                                android:clickable="true"
                                android:drawableEnd="@drawable/ic_dropdown"
                                android:drawablePadding="6dp"
                                android:focusable="true"
                                android:gravity="center_vertical"
                                android:paddingLeft="10dp"
                                android:paddingTop="4dp"
                                android:paddingRight="10dp"
                                android:paddingBottom="4dp"
                                android:textColor="@color/white"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/camera_info"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom|start"
                                android:layout_margin="10dp"
                                android:background="@drawable/bg_feed_label"
                                android:paddingLeft="10dp"
                                android:paddingTop="4dp"
                                android:paddingRight="10dp"
                                android:paddingBottom="4dp"
                                android:textColor="@color/white"
                                android:textSize="12sp" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/ai_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ======================= Bottom row ======================= -->
                <LinearLayout
                    android:id="@+id/columns_bottom"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/gap"
                    android:layout_weight="1">

                    <!--
                      The LiDAR map, under the robot it belongs to and kept exactly as wide as it
                      (RobotControlActivity#matchLidarWidth). The title opens the full LiDAR page.
                    -->
                    <LinearLayout
                        android:id="@+id/lidar_panel"
                        style="@style/RobotPanel"
                        android:tag="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/lidar_title"
                                style="@style/RobotPanelTitle"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:clickable="true"
                                android:focusable="true"
                                android:text="@string/nav_lidar" />

                            <ImageButton
                                android:id="@+id/lidar_load_map"
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_marginStart="6dp"
                                android:background="?android:attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/load_map"
                                android:padding="5dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_folder_open" />

                            <ImageButton
                                android:id="@+id/lidar_fullscreen"
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_marginStart="6dp"
                                android:background="?android:attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/full_screen"
                                android:padding="5dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_fullscreen" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="6dp"
                            android:background="@color/divider" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginTop="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_table_box"
                            android:minHeight="160dp">

                            <com.falcon.robot.widget.LidarMapView
                                android:id="@+id/lidar_map"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />
                        </FrameLayout>
                    </LinearLayout>

                    <!--
                      Camera Settings: its own panel, rather than a column squeezed in beside the feed
                      where the last rows were cut off. It scrolls, so every row is reachable.
                    -->
                    <LinearLayout
                        android:id="@+id/camera_settings_panel"
                        style="@style/RobotPanel"
                        android:tag="1.15">

                        <TextView
                            android:id="@+id/camera_settings_title"
                            style="@style/RobotPanelTitle"
                            android:text="@string/camera_settings" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="6dp"
                            android:background="@color/divider" />

                        <com.falcon.robot.widget.PanelScrollView
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginTop="8dp"
                            android:layout_weight="1"
                            android:scrollbars="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/label_brightness"
                                    style="@style/SettingLabel"
                                    android:layout_marginTop="8dp"
                                    android:text="@string/brightness" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <SeekBar
                                        android:id="@+id/seek_brightness"
                                        android:layout_width="0dp"
                                        android:layout_height="28dp"
                                        android:layout_weight="1"
                                        android:max="100"
                                        android:maxHeight="4dp"
                                        android:minHeight="4dp"
                                        android:paddingStart="8dp"
                                        android:paddingEnd="8dp"
                                        android:progress="50"
                                        android:progressDrawable="@drawable/progress_loading"
                                        android:splitTrack="false"
                                        android:thumb="@drawable/seekbar_thumb" />

                                    <TextView
                                        android:id="@+id/value_brightness"
                                        android:layout_width="36dp"
                                        android:layout_height="wrap_content"
                                        android:gravity="end"
                                        android:textColor="@color/text_primary"
                                        android:textSize="11sp" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/label_contrast"
                                    style="@style/SettingLabel"
                                    android:text="@string/contrast" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <SeekBar
                                        android:id="@+id/seek_contrast"
                                        android:layout_width="0dp"
                                        android:layout_height="28dp"
                                        android:layout_weight="1"
                                        android:max="100"
                                        android:maxHeight="4dp"
                                        android:minHeight="4dp"
                                        android:paddingStart="8dp"
                                        android:paddingEnd="8dp"
                                        android:progress="50"
                                        android:progressDrawable="@drawable/progress_loading"
                                        android:splitTrack="false"
                                        android:thumb="@drawable/seekbar_thumb" />

                                    <TextView
                                        android:id="@+id/value_contrast"
                                        android:layout_width="36dp"
                                        android:layout_height="wrap_content"
                                        android:gravity="end"
                                        android:textColor="@color/text_primary"
                                        android:textSize="11sp" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/label_saturation"
                                    style="@style/SettingLabel"
                                    android:text="@string/saturation" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <SeekBar
                                        android:id="@+id/seek_saturation"
                                        android:layout_width="0dp"
                                        android:layout_height="28dp"
                                        android:layout_weight="1"
                                        android:max="100"
                                        android:maxHeight="4dp"
                                        android:minHeight="4dp"
                                        android:paddingStart="8dp"
                                        android:paddingEnd="8dp"
                                        android:progress="50"
                                        android:progressDrawable="@drawable/progress_loading"
                                        android:splitTrack="false"
                                        android:thumb="@drawable/seekbar_thumb" />

                                    <TextView
                                        android:id="@+id/value_saturation"
                                        android:layout_width="36dp"
                                        android:layout_height="wrap_content"
                                        android:gravity="end"
                                        android:textColor="@color/text_primary"
                                        android:textSize="11sp" />
                                </LinearLayout>

                                <TextView
                                    style="@style/SettingLabel"
                                    android:layout_marginTop="12dp"
                                    android:text="@string/resolution" />

                                <FrameLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp">

                                    <Spinner
                                        android:id="@+id/camera_resolution"
                                        style="@style/Dropdown"
                                        android:layout_height="36dp" />

                                    <ImageView
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:layout_gravity="end|center_vertical"
                                        android:layout_marginEnd="8dp"
                                        android:contentDescription="@null"
                                        android:src="@drawable/ic_dropdown" />
                                </FrameLayout>

                                <TextView
                                    style="@style/SettingLabel"
                                    android:layout_marginTop="8dp"
                                    android:text="@string/fps" />

                                <FrameLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp">

                                    <Spinner
                                        android:id="@+id/camera_fps"
                                        style="@style/Dropdown"
                                        android:layout_height="36dp" />

                                    <ImageView
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:layout_gravity="end|center_vertical"
                                        android:layout_marginEnd="8dp"
                                        android:contentDescription="@null"
                                        android:src="@drawable/ic_dropdown" />
                                </FrameLayout>
                            </LinearLayout>
                        </com.falcon.robot.widget.PanelScrollView>
                    </LinearLayout>

                    <!-- Log: switched on here, and then every recognition result lands in it -->
                    <LinearLayout
                        style="@style/RobotPanel"
                        android:tag="1.1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/log_title"
                                style="@style/RobotPanelTitle"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:text="@string/panel_log" />

                            <TextView
                                android:id="@+id/btn_log"
                                android:layout_width="wrap_content"
                                android:layout_height="26dp"
                                android:background="@drawable/bg_control_button"
                                android:clickable="true"
                                android:drawablePadding="6dp"
                                android:focusable="true"
                                android:gravity="center"
                                android:paddingLeft="12dp"
                                android:paddingRight="14dp"
                                android:singleLine="true"
                                android:text="@string/log_start"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="6dp"
                            android:background="@color/divider" />

                        <com.falcon.robot.widget.PanelScrollView
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginTop="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_table_box"
                            android:padding="8dp"
                            android:scrollbars="vertical">

                            <!-- Filled by RobotControlActivity#renderLog -->
                            <LinearLayout
                                android:id="@+id/log_list"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical" />
                        </com.falcon.robot.widget.PanelScrollView>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.falcon.robot.widget.FitScrollView>

        <!--
          Actions, down the right-hand side: the recognition switches and everything the robot
          is asked to do, one button per row. The sidebar is outside the scrolling page, so it
          stays put wherever the panels are scrolled to, and stays in reach with a panel full
          screen; the list itself scrolls (PanelScrollView). Driving is the Remote Control page's
          job, so there is no joystick or speed slider here.
        -->
        <LinearLayout
            android:id="@+id/action_sidebar"
            style="@style/RobotPanel"
            android:layout_width="@dimen/action_sidebar_width"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/screen_padding"
            android:layout_marginEnd="@dimen/screen_padding"
            android:layout_marginBottom="@dimen/screen_padding">

            <TextView
                android:id="@+id/actions_title"
                style="@style/RobotPanelTitle"
                android:text="@string/panel_actions" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="6dp"
                android:background="@color/divider" />

            <com.falcon.robot.widget.PanelScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:scrollbars="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/ai_title"
                        style="@style/SettingLabel"
                        android:text="@string/panel_ai" />

                    <TextView
                        android:id="@+id/toggle_face"
                        style="@style/SidebarButton"
                        android:layout_marginTop="6dp"
                        android:text="@string/feature_face" />

                    <TextView
                        android:id="@+id/toggle_object"
                        style="@style/SidebarButton"
                        android:layout_marginTop="6dp"
                        android:text="@string/feature_object" />

                    <TextView
                        android:id="@+id/toggle_voice"
                        style="@style/SidebarButton"
                        android:layout_marginTop="6dp"
                        android:text="@string/feature_voice" />

                    <TextView
                        android:id="@+id/move_title"
                        style="@style/SettingLabel"
                        android:layout_marginTop="14dp"
                        android:text="@string/move_control" />

                    <TextView
                        android:id="@+id/move_forward"
                        style="@style/SidebarButton"
                        android:layout_marginTop="6dp"
                        android:text="@string/act_forward" />

                    <TextView
                        android:id="@+id/move_backward"
                        style="@style/SidebarButton"
                        android:layout_marginTop="6dp"
                        android:text="@string/act_backward" />

                    <TextView
                        android:id="@+id/move_left"
                        style="@style/SidebarButton"
                        android:layout_marginTop="6dp"
                        android:text="@string/act_turn_left" />

                    <TextView
                        android:id="@+id/move_right"
                        style="@style/SidebarButton"
                        android:layout_marginTop="6dp"
                        android:text="@string/act_turn_right" />

                    <TextView
                        android:id="@+id/move_stop"
                        style="@style/SidebarButton"
                        android:layout_marginTop="6dp"
                        android:text="@string/act_stop" />

                    <TextView
                        android:id="@+id/arm_title"
                        style="@style/SettingLabel"
                        android:layout_marginTop="14dp"
                        android:text="@string/arm_control" />

                    <TextView
                        android:id="@+id/arm_left"
                        style="@style/SidebarButton"
                        android:layout_marginTop="6dp"
                        android:text="@string/arm_left" />

                    <TextView
                        android:id="@+id/arm_right"
                        style="@style/SidebarButton"
                        android:layout_marginTop="6dp"
                        android:text="@string/arm_right" />

                    <TextView
                        style="@style/SettingLabel"
                        android:layout_marginTop="14dp"
                        android:text="@string/preset_pose" />

                    <TextView
                        android:id="@+id/pose_wave"
                        style="@style/SidebarButton"
                        android:layout_marginTop="6dp"
                        android:text="@string/pose_wave" />

                    <TextView
                        android:id="@+id/pose_hello"
                        style="@style/SidebarButton"
                        android:layout_marginTop="6dp"
                        android:text="@string/cmd_hello" />

                    <TextView
                        android:id="@+id/pose_tpose"
                        style="@style/SidebarButton"
                        android:layout_marginTop="6dp"
                        android:text="@string/pose_t" />

                    <TextView
                        android:id="@+id/pose_dance"
                        style="@style/SidebarButton"
                        android:layout_marginTop="6dp"
                        android:text="@string/cmd_dance" />

                    <TextView
                        android:id="@+id/quick_title"
                        style="@style/SettingLabel"
                        android:layout_marginTop="14dp"
                        android:text="@string/quick_actions" />

                    <TextView
                        android:id="@+id/qa_follow"
                        style="@style/SidebarButton"
                        android:layout_marginTop="6dp"
                        android:text="@string/qa_follow_me" />

                    <TextView
                        android:id="@+id/qa_recording"
                        style="@style/SidebarButton"
                        android:layout_marginTop="6dp"
                        android:text="@string/cmd_recording" />

                    <TextView
                        android:id="@+id/qa_no"
                        style="@style/SidebarButton"
                        android:layout_marginTop="6dp"
                        android:text="@string/cmd_no" />

                    <TextView
                        android:id="@+id/qa_home"
                        style="@style/SidebarButton"
                        android:layout_marginTop="6dp"
                        android:text="@string/qa_go_home" />

                    <TextView
                        android:id="@+id/qa_shutdown"
                        style="@style/SidebarButton"
                        android:layout_marginTop="6dp"
                        android:text="@string/qa_shutdown" />
                </LinearLayout>
            </com.falcon.robot.widget.PanelScrollView>
        </LinearLayout>
    </LinearLayout>

    <!--
      Status bar: the last thing that happened, wherever on the page it happened. It sits outside
      the scrolling content, so it is in view even with a panel full screen.
    -->
    <TextView
        android:id="@+id/robot_tip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:drawablePadding="10dp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:minHeight="40dp"
        android:paddingLeft="@dimen/screen_padding"
        android:paddingRight="@dimen/screen_padding"
        android:singleLine="true"
        android:text="@string/robot_tip"
        android:textColor="@color/blue_light"
        android:textSize="12sp" />
</LinearLayout>
