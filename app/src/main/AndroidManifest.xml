<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Used only to show the Wi-Fi indicator in the in-app status row. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Face recognition camera -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!-- Speech recognition (whisper.cpp) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Recognition keeps running in the background (RobotService) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RobotControl">

        <activity
            android:name=".SplashActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:theme="@style/Theme.RobotControl.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="false" />

        <activity
            android:name=".RobotControlActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="false" />

        <activity
            android:name=".RemoteControlActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="false" />

        <activity
            android:name=".FaceRecognitionActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="false" />

        <activity
            android:name=".VoiceRecognitionActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="false" />

        <activity
            android:name=".ObjectDetectionActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="false" />

        <activity
            android:name=".LidarSlamActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="false" />

        <activity
            android:name=".SettingsActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="false" />

        <!-- Camera, microphone and the models, so they keep working off-screen -->
        <service
            android:name=".RobotService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />
    </application>

</manifest>
